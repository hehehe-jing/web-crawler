#    判断是否涨停
from loguru import logger
import time
import numpy as np
import pandas as pd

def tdx_ema(sr: pd.Series, n):
    return sr.ewm(alpha=2 / (n + 1), adjust=False).mean()

def tdx_ema1(sr: pd.Series, sr1: pd.Series,n):
    alpha=2 / (n + 1)
    return sr*alpha + sr1*(1-alpha)

def tdx_sma2(series, n, m):
    alpha = m / n
    return series.ewm(alpha=alpha, adjust=False).mean()

def hhv(sr:pd.Series,n):
    return sr.rolling(n,min_periods=1).max()

def llv(sr:pd.Series,n):
    return sr.rolling(n,min_periods=1).min()

def tdx_ma(series: pd.Series, n: int):
    return series.rolling(n).mean()

def sum_1(series: pd.Series, n: int):
    return series.rolling(n).sum()

# 将有信号的标为1，无信号的标为0，而且在本次信号出现后，n天内不再出现信号
def filter_tdx(cond, n):
    cond_values = cond.values
    res = np.zeros(len(cond_values), dtype=int)
    last = -999
    for i in range(len(cond_values)):
        if cond_values[i] == 1 and i - last > n:
            res[i] = 1
            last = i
    return pd.Series(res, index=cond.index)

def calc_code_day(ser):
    groups = (ser == 1).cumsum()          # 每遇到一次信号，组号 +1
    return ser.groupby(groups).cumcount() # 组内从 0 开始编号

def ref_bottom_high(pre_daybar, extra=0):
    high_lag = pre_daybar.groupby('symbol')['high'].shift(extra)
    bottom_high  = high_lag.where(pre_daybar['initial_bottoming'] == 1)
    return bottom_high.groupby(pre_daybar['symbol']).ffill()

def llv_since_bottom(pre_daybar):
    seg = pre_daybar.groupby('symbol')['initial_bottoming'].cumsum()
    return pre_daybar.groupby(['symbol', seg])['low'].cummin()

def daily_date(pre_daybar):
    pre_daybar = pre_daybar[['symbol','date','high','low','close','open','preClose','volume','amount','circulating_capital','name']].copy()
    pre_daybar = pre_daybar.sort_values(['symbol','date']).reset_index(drop = True)
    pre_daybar['is_st'] = pre_daybar['name'].str.contains('ST', na=False).astype(int)
    pre_daybar['date_str'] = pd.to_datetime(pre_daybar['date'].astype(str))
    pre_daybar['list_days_max'] = pre_daybar.groupby(['symbol'])['date_str'].transform('max')
    pre_daybar['list_days_min'] = pre_daybar.groupby(['symbol'])['date_str'].transform('min')
    pre_daybar['code_day'] = (pre_daybar['list_days_max'] - pre_daybar['list_days_min']).dt.days +1

    return pre_daybar


def minbar_date(this_minbar,pre_daybar):
    this_minbar['close'] = this_minbar['close'].round(2)
    this_minbar = this_minbar.sort_values(['symbol', 'time']).reset_index(drop=True)
    this_minbar['time_copy'] = (pd.to_datetime(this_minbar['time']) - pd.Timedelta(minutes=1)).dt.time
    this_minbar['code_day'] = this_minbar['code_day_pre'] + 1
    this_minbar['hs_zhangting'] = (this_minbar['preClose']*1.1).round(2)
    this_minbar['kc_zhangting'] = (this_minbar['preClose']*1.2).round(2)
    
    this_minbar['is_10'] = np.where(this_minbar['symbol'].str.startswith(('600','601','603','605','000','001','002','003','900','200')),1,0)
    this_minbar['is_20'] = np.where(this_minbar['symbol'].str.startswith(('300','301','688','689')),1,0)

    this_minbar['is_zhangting_10'] = np.where((this_minbar['code_day'] > 5)
     & (this_minbar['is_10'] == 1) 
     &(this_minbar['close'] == this_minbar['hs_zhangting'])
     ,1,0)

    this_minbar['is_zhangting_20'] = np.where((this_minbar['code_day'] > 5)
     & (this_minbar['is_20'] == 1) 
     &(this_minbar['close'] == this_minbar['kc_zhangting'])
     ,1,0)





    return this_minbar


def calc__yzgdqdf(this_minbar, pre_daybar):

    pre_daybar = daily_date(pre_daybar)
    tdf = pre_daybar.sort_values(['symbol', 'date',], ascending=True).drop_duplicates(['symbol'], keep='last')
    use_c = ['symbol','close','code_day']
    tdf = tdf[use_c]
    r_c = {c: f"{c}_pre" for c in use_c if c != "symbol"}
    tdf.rename(columns=r_c, inplace=True)
    this_minbar = pd.merge(this_minbar, tdf, on="symbol", how="left")
    _t0 = time.perf_counter()
    this_minbar = minbar_date(this_minbar,tdf)
    _t1 = time.perf_counter()
    logger.info(f"[耗时] calc_today__yzgdqdf ) {_t1 - _t0:>8.2f} 秒")
    return this_minbar  
