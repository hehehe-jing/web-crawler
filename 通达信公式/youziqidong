from loguru import logger
import time
import numpy as np
import pandas as pd

def tdx_ema(sr: pd.Series, n):
    return sr.ewm(alpha=2 / (n + 1), adjust=False).mean()

def filter_tdx_correct(cond:pd.Series, n:int)->pd.Series:
    cond_arr = cond.to_numpy(bool)
    idx_arr = np.arange(len(cond_arr))
    hits = idx_arr[cond_arr]
    if hits.size == 0:
        return pd.Series(np.zeros_like(cond_arr,int), index=cond.index)
    valid = []
    last = -np.inf
    for pos in hits:
        if pos > last:
            valid.append(pos)
            last = pos + n
    res = np.zeros_like(cond_arr, dtype=int)
    res[valid] = 1
    return pd.Series(res, index=cond.index)

def calc_code_day(ser:pd.Series):
        # ser: yzgdqdf_yzqd，按时间升序
        cd = []
        last_cd = 0
        for flag in ser:
            if flag == 1:
                last_cd = 0 
            else:
                last_cd += 1
            cd.append(last_cd)
        return pd.Series(cd, index=ser.index)


def warm__yzgdqdf(pre_daybar):

#日线数据
    pre_daybar = pre_daybar[["symbol", "date", "close","preClose","high"]].copy()
    pre_daybar = pre_daybar.sort_values(["symbol", "date"]).reset_index(drop=True)
    pre_daybar["yzgdqdf_abc16"]=np.where(pre_daybar['close']>pre_daybar['preClose'],88,0)

    pre_daybar["yzgdqdf_abc17"]=np.where(((pre_daybar['close']/pre_daybar['preClose'])>1.05)&((pre_daybar["high"]/pre_daybar['close'])<1.01)&(pre_daybar["yzgdqdf_abc16"]>0),91,0)
    pre_daybar["yzgdqdf_yzqd"]=pre_daybar.groupby("symbol")["yzgdqdf_abc17"].transform(
    lambda s: filter_tdx_correct(s>90,45)
)
    pre_daybar["code_day"] = pre_daybar.groupby("symbol")["yzgdqdf_yzqd"].transform(calc_code_day)

    return pre_daybar



def calc_today__yzgdqdf(this_minbar, pre_daybar): 

    this_minbar["day_high"] = this_minbar.groupby(["symbol"])["high"].cummax()
    this_minbar["yzgdqdf_abc16"]=np.where(this_minbar['close']>this_minbar['close_pre'],88,0)
    this_minbar["yzgdqdf_abc17"]=np.where(((this_minbar['close']/this_minbar['close_pre'])>1.05)&((this_minbar["day_high"]/this_minbar['close'])<1.01)&(this_minbar["yzgdqdf_abc16"]>0),91,0)
    
    this_minbar["yzgdqdf_yzqd_pre"]=np.where((this_minbar['yzgdqdf_abc17']>0)&(this_minbar["code_day_pre"]>=45),1,0)
    
    this_minbar["yzgdqdf_yzqd"]=np.where((this_minbar['yzgdqdf_yzqd_pre']==1),1,0)

    drop_c = [
        'day_high','yzgdqdf_abc16',"yzgdqdf_abc17","yzgdqdf_yzqd_pre"]
    this_minbar.drop(columns=[c for c in drop_c if c in this_minbar.columns], inplace=True)
    return this_minbar

def calc__yzgdqdf(this_minbar, pre_daybar):

    pre_daybar = warm__yzgdqdf(pre_daybar)
    tdf = pre_daybar.sort_values(['symbol', 'date',], ascending=True).drop_duplicates(['symbol'], keep='last')
    use_c = ["symbol","close","code_day"]
    tdf = tdf[use_c]
    r_c = {c: f"{c}_pre" for c in use_c if c != "symbol"}
    tdf.rename(columns=r_c, inplace=True)
    this_minbar = pd.merge(this_minbar, tdf, on="symbol", how="left")
    _t0 = time.perf_counter()
    this_minbar = calc_today__yzgdqdf(this_minbar,tdf)
    _t1 = time.perf_counter()
    logger.info(f"[耗时] calc_today__yzgdqdf ) {_t1 - _t0:>8.2f} 秒")
    return this_minbar  








